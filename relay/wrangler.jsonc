{
  // The Atlas VTT relay: one Worker that serves the player client and one Durable Object per table.
  // Nothing here names an account, a route or a secret: the account comes from the deploy workflow's
  // environment, and the host key is a Worker secret set by hand (`npx wrangler secret put HOST_KEY`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "TableObject" },
      { "name": "HOSTS", "class_name": "HostRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableObject", "HostRegistry"] }
  ],
  "assets": {
    "directory": "../player/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/__atlas-online-seat"]
  }
}
